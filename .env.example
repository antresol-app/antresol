# --- Required ---
# Media folder on the host (mounted at /media)
MEDIA_DIR=/srv/media
# https://www.themoviedb.org/settings/api
VAULT_TMDB_KEY=
# e.g. Europe/Berlin
TZ=

# --- Optional ---
# auto | qsv | vaapi | nvenc | videotoolbox | none
VAULT_HWACCEL=auto
# Your reverse proxy's address
VAULT_TRUSTED_PROXIES=

# Everything else: docs/configuration.md
