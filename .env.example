# Copy to .env (docker run --env-file .env, or next to your compose file).
# No secrets here; put your keys into your own .env.
# The media folder on the HOST (compose.yml mounts it at /media in the container).
MEDIA_DIR=/srv/media
# Folder names inside it, if yours differ: MOVIES_DIR, SERIES_DIR, MUSIC_DIR,
# EBOOKS_DIR, AUDIOBOOKS_DIR, COMICS_DIR (see README). VAULT_* paths are
# container paths: never put host paths into them.
# TMDB API key for film and series metadata (https://www.themoviedb.org/settings/api).
VAULT_TMDB_KEY=
# OpenSubtitles (automatic subtitles): API key and account. Secrets: your .env only.
# VAULT_OPENSUBTITLES_KEY=
# VAULT_OPENSUBTITLES_USER=
# VAULT_OPENSUBTITLES_PASSWORD=
# Hardware transcoding: auto, qsv, vaapi, nvenc, videotoolbox or none. auto
# tries the GPUs it sees with a short test encode at start (README,
# "Hardware transcoding"); the container needs the GPU (compose.yml).
# Manage → Settings → Transcoding overrides these once changed there.
VAULT_HWACCEL=auto
# The render node for vaapi when there are several (default: the first).
# VAULT_HWACCEL_DEVICE=/dev/dri/renderD128
# HLS segments (remux/transcode), live TV and offline copies; keep them off
# /config. compose.yml sets this itself: to move them with compose, use a
# compose.override.yml (README, "Temporary files on another disk").
# VAULT_TRANSCODE_DIR=/media/tmp/antresol-hls
# Total HLS segment limit (default 20 GB).
# VAULT_TRANSCODE_MAX_BYTES=21474836480
# VAULT_REPACK_TS=off   # keep .ts/.m2ts films as they are (default: repack into .mkv)
# Address of your reverse proxy: only it is trusted for X-Forwarded-For.
VAULT_TRUSTED_PROXIES=
# Extra home networks, comma separated, e.g. Tailscale: 100.64.0.0/10
# VAULT_TRUSTED_NETS=
# Where the source code of this server is (AGPL §13): the link of «Source code · AGPL».
# Set it when you run a modified server for others; set but empty: no link.
# VAULT_SOURCE_URL=https://example.org/my-fork
# Opt-in: how much of the database SQLite maps into memory (default 0: off).
# Reads get much faster, but a read error on the disk holding /config then
# kills the whole server instead of failing one request: use it only with
# the database on a reliable disk.
# VAULT_DB_MMAP_BYTES=268435456
# The apps find the server on the home network: mDNS and a UDP probe port
# (publish it as 8420:8420/udp; host networking for broadcast and mDNS).
# VAULT_SERVER_NAME=Antresol
# VAULT_DISCOVERY=off      # neither of them
# VAULT_MDNS=off           # mDNS only
# VAULT_DISCOVERY_PORT=8420
# Time zone, e.g. Europe/Berlin
TZ=
