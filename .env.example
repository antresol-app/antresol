# Copy to .env (docker run --env-file .env, or next to your compose file).
# No secrets here; put your keys into your own .env.
# TMDB API key for film and series metadata (https://www.themoviedb.org/settings/api).
VAULT_TMDB_KEY=
# OpenSubtitles (automatic subtitles): API key and account. Secrets: your .env only.
# VAULT_OPENSUBTITLES_KEY=
# VAULT_OPENSUBTITLES_USER=
# VAULT_OPENSUBTITLES_PASSWORD=
# Hardware video decoding: auto, qsv, videotoolbox or none. Takes effect with
# the binary on the host; the image has no GPU video driver yet (see README).
VAULT_HWACCEL=auto
# HLS segments (remux/transcode) — keep them on the media disk, not in /config.
# VAULT_TRANSCODE_DIR=/media/tmp/antresol-hls
# Total HLS segment limit (default 20 GB).
# VAULT_TRANSCODE_MAX_BYTES=21474836480
# VAULT_REPACK_TS=off   # keep .ts/.m2ts films as they are (default: repack into .mkv)
# Address of your reverse proxy: only it is trusted for X-Forwarded-For.
VAULT_TRUSTED_PROXIES=
# Extra home networks, comma separated, e.g. Tailscale: 100.64.0.0/10
# VAULT_TRUSTED_NETS=
# Where the source code of this server is (AGPL §13): the link of «Source code · AGPL».
# Set it when you run a modified server for others; set but empty: no link.
# VAULT_SOURCE_URL=https://example.org/my-fork
# Time zone, e.g. Europe/Berlin
TZ=
